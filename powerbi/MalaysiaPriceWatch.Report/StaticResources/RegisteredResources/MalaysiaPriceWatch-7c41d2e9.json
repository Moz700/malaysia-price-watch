{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.159.json",
  "name": "MalaysiaPriceWatch-7c41d2e9.json",
  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#e34948",
    "#535b67",
    "#c8cdd4",
    "#1f63b8",
    "#8fb7e8",
    "#f2a684"
  ],
  "foreground": "#262a30",
  "foregroundNeutralSecondary": "#535b67",
  "foregroundNeutralTertiary": "#535b67",
  "background": "#FFFFFF",
  "backgroundLight": "#f4f6f8",
  "backgroundNeutral": "#dde1e6",
  "tableAccent": "#2a78d6",
  "good": "#2a78d6",
  "neutral": "#c8cdd4",
  "bad": "#e34948",
  "maximum": "#2a78d6",
  "center": "#f4f6f8",
  "minimum": "#eb6834",
  "null": "#c8cdd4",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#262a30"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#262a30"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#262a30"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#262a30"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "fontColor": {
              "solid": {
                "color": "#262a30"
              }
            },
            "titleWrap": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#dde1e6"
              }
            },
            "radius": 4
          }
        ],
        "padding": [
          {
            "top": 8,
            "bottom": 8,
            "left": 10,
            "right": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit"
          }
        ]
      }
    }
  }
}
