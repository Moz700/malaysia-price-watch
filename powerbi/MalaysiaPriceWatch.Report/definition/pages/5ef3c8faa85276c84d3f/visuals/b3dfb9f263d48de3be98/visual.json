          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "How the indexes work",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "11pt",
                      "color": "#0F2440"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#13243B"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Price index: a shop's price for an item divided by that item's national median in September 2026, averaged over the items the shop prices, times 100. Below 100 is cheaper than the national median.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#13243B"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#13243B"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Basket index: the cost of the same 265 items, each priced in at least 13 of the 16 states, divided by the national cost of that basket, times 100. Where a state has no price for an item, the national median fills in.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#13243B"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#13243B"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "District index: the average ratio of a district's median price to the national median over the basket items it prices. Districts with too few items priced are not scored.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#13243B"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
