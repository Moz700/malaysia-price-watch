/// Where the 8 CSV files are read from. Default: the public GitHub repo. To use a local copy, set it to the folder path, for example C:\malaysia-price-watch\dashboard\data\
expression DataSource = "https://raw.githubusercontent.com/Moz700/malaysia-price-watch/main/dashboard/data/" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

/// Loads one CSV file from DataSource and sets every column type with culture en-US. Columns typed as logical turn t/f into true/false. Web paths use Web.Contents with a fixed host and RelativePath, so the Power BI service can refresh without a gateway.
expression fnLoadCsv =
		(fileName as text, columnTypes as list) as table =>
		let
			IsWeb = Text.StartsWith(DataSource, "http"),
			// For the web, keep the host fixed and pass the rest of the path as RelativePath
			WebPath = Text.AfterDelimiter(DataSource, "raw.githubusercontent.com/"),
			LocalFolder = if Text.EndsWith(DataSource, "\") or Text.EndsWith(DataSource, "/") then DataSource else DataSource & "\",
			#"Read csv file" = if IsWeb
				then Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath = WebPath & fileName]), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv])
				else Csv.Document(File.Contents(LocalFolder & fileName), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			#"Promoted headers" = Table.PromoteHeaders(#"Read csv file", [PromoteAllScalars = true]),
			#"Kept listed columns" = Table.SelectColumns(#"Promoted headers", List.Transform(columnTypes, each _{0})),
			#"Replaced empty text with null" = Table.TransformColumns(#"Kept listed columns", {}, each if _ = "" then null else _),
			// PostgreSQL writes booleans as t and f
			#"Listed logical columns" = List.Select(columnTypes, each Type.Is(_{1}, type logical)),
			#"Converted t and f" = Table.TransformColumns(#"Replaced empty text with null", List.Transform(#"Listed logical columns", (c) => {c{0}, each if _ = "t" then true else if _ = "f" then false else null})),
			#"Set column types" = Table.TransformColumnTypes(#"Converted t and f", columnTypes, "en-US")
		in
			#"Set column types"
