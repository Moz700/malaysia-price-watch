/// premise_index.csv: one row per shop (premise). Price index against the national median of the same items (100 = national), and its price quarter within its state (1 = cheapest). Logic of q11 and q19.
table 'Shop index'
	lineageTag: 05d1c44f-414c-412c-bea3-cbf51c49d184

	/// KPDN premise code.
	column 'Shop code'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 41460971-1363-46d6-b284-9d45e384b73b
		summarizeBy: none
		sourceColumn: premise_code

	/// Shop (premise) name.
	column Shop
		dataType: string
		lineageTag: 0524a10a-4d15-48e8-b929-79ce8f1889e5
		summarizeBy: none
		sourceColumn: premise

	/// Key to Shop type.
	column 'Shop type'
		dataType: string
		isHidden
		lineageTag: 52571d3b-5db2-45b3-8f1c-fba65ab1415c
		summarizeBy: none
		sourceColumn: premise_type

	/// Key to State.
	column State
		dataType: string
		isHidden
		lineageTag: 69757e78-2478-4c15-913e-00b58b48004d
		summarizeBy: none
		sourceColumn: state

	/// District of the shop.
	column District
		dataType: string
		lineageTag: 94de7fa8-393a-414f-a8de-9b355ded10d6
		summarizeBy: none
		sourceColumn: district

	/// Items priced at the shop.
	column 'Items priced'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e6ca4a2e-dba8-4303-92f0-62aeed5e300d
		summarizeBy: none
		sourceColumn: items_priced

	/// Shop price index, 100 = national median of the same items.
	column 'Price index'
		dataType: decimal
		isHidden
		formatString: 0.0
		lineageTag: 3a611208-2edd-48a1-88ae-748ffeab6903
		summarizeBy: none
		sourceColumn: price_index

	/// 1 = cheapest quarter of shops in the state, 4 = dearest.
	column 'Price quarter in state'
		dataType: int64
		formatString: 0
		lineageTag: f32ef623-e26b-4ddf-b214-b4b1e17cab3a
		summarizeBy: none
		sourceColumn: price_quartile_in_state

	partition 'Shop index' = m
		mode: import
		source =
				let
					Source = fnLoadCsv("premise_index.csv", {{"premise_code", Int64.Type}, {"premise", type text}, {"premise_type", type text}, {"state", type text}, {"district", type text}, {"items_priced", Int64.Type}, {"price_index", Currency.Type}, {"price_quartile_in_state", Int64.Type}})
				in
					Source

