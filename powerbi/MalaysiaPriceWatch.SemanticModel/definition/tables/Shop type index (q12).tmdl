/// Average shop's price index by state and shop type, as printed in results/build_run/q12.txt (second table): 79 state and shop-type pairs (W.P. Labuan has no sundry shop). premise_index.csv rounds each shop's index to 0.1, so a mean taken from it can be 0.1 off; this table keeps the printed values. 100 = national median of the same items.
table 'Shop type index (q12)'
	lineageTag: c183d2c0-7f8b-409d-9796-0553b9fd604e

	/// Key to State.
	column State
		dataType: string
		isHidden
		lineageTag: 5221d2af-2ed9-4ce9-8090-fd811f052e66
		summarizeBy: none
		sourceColumn: state

	/// Key to Shop type.
	column 'Shop type'
		dataType: string
		isHidden
		lineageTag: 2e54a1f2-4e7e-4f2c-a245-ad9aa0ae6b68
		summarizeBy: none
		sourceColumn: premise_type

	/// Average shop's price index, 100 = national median of the same items.
	column 'Average shop index'
		dataType: decimal
		isHidden
		formatString: 0.0
		lineageTag: 03b4ec26-c7ed-4963-a8f9-ca60a34eb87f
		summarizeBy: none
		sourceColumn: avg_price_index

	partition 'Shop type index (q12)' = m
